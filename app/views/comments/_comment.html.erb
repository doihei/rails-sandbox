<div id="<%= dom_id(comment) %>"
     class="flex gap-3 py-4 border-b border-gray-100 last:border-0">
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-sm font-medium text-gray-800">
        <%= comment.user.name.presence || comment.user.email %>
      </span>
      <span class="text-xs text-gray-400">
        <%= l comment.created_at, format: :long %>
      </span>
    </div>
    <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap"><%= comment.body %></p>
  </div>
  <%= button_to likes_path(likeable_type: "Comment", likeable_id: comment.id),
      method: :post,
      class: "text-xs border border-gray-200 rounded px-2 py-1 cursor-pointer bg-white h-fit flex-shrink-0" do %>
    <%= comment.likes.any? { |l| l.user_id == current_user.id } ? t('.liked') : t('.like') %>
    (<%= comment.likes.size %>)
  <% end %>
  <% if comment.user == current_user %>
    <%= button_to t('.delete'), article_comment_path(@article, comment),
        method: :delete,
        data: { turbo_confirm: t('.confirm_delete') },
        class: "text-xs text-red-400 hover:text-red-600 border border-red-200 rounded px-2 py-1 cursor-pointer bg-white h-fit flex-shrink-0" %>
  <% end %>
</div>
