<nav class="bg-blue-200 border-b border-gray-200 dark:border-gray-700">
  <div class="mx-auto max-w-7xl px-4">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center space-x-8">
        <%= link_to t('app_name'), root_path, class: "font-semibold text-gray-800 hover:text-gray-600" %>

        <div class="hidden md:flex space-x-4">
          <%= link_to t('articles.index.title'),
                      articles_path,
                      class: "nav-link #{current_page?(articles_path) ? 'active' : ''}" %>

          <%= link_to t('articles.popular.title'),
                      popular_articles_path,
                      class: "nav-link #{current_page?(popular_articles_path) ? 'active' : ''}" %>
        </div>
      </div>

      <div class="flex items-center gap-4 text-sm">
        <% if user_signed_in? %>
          <span class="text-gray-500 dark:text-gray-400"><%= current_user.email %></span>
          <%= button_to t('nav.logout'), destroy_user_session_path, method: :delete,
              class: "text-gray-600 dark:text-gray-300 border border-gray-300 dark:border-gray-600 rounded px-3 py-1 cursor-pointer bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
