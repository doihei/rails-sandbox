<% content_for :title, @article.title %>

<div class="bg-white border border-gray-200 rounded-lg p-6">

  <% if @article.tags.any? %>
    <div class="flex flex-wrap gap-1.5 mb-4">
      <% @article.tags.each do |tag| %>
        <%= render(TagBadgeComponent.new(tag: tag)) %>
      <% end %>
    </div>
  <% end %>

  <div class="flex justify-between items-start mb-4">
    <h1 class="text-xl font-semibold text-gray-800"><%= @article.title %></h1>
    <%= render(StatusBadgeComponent.new(status: @article.status)) %>
  </div>

  <p class="text-sm text-gray-500 mb-4">
    <%= @article.user.name || @article.user.email %> &middot;
    <%= @article.created_at.strftime("%Y/%m/%d") %>
  </p>

  <div class="text-gray-700 leading-relaxed mb-6 whitespace-pre-wrap">
    <%= @article.body %>
  </div>

  <div class="flex items-center gap-3 pt-4 border-t border-gray-100 text-sm">
    <% if !@article.status.published? && @article.user == current_user %>
      <%= button_to t('.publish'), publish_article_path(@article),
          method: :patch,
          data: { turbo_confirm: t('.confirm_publish') },
          class: "bg-gray-800 text-white px-4 py-1.5 rounded hover:bg-gray-700 cursor-pointer" %>
    <% end %>
    <% if @article.user == current_user %>
      <%= link_to t('.edit'), edit_article_path(@article),
          class: "text-gray-600 border border-gray-300 px-4 py-1.5 rounded hover:bg-gray-50" %>
      <%= button_to t('.delete'), @article, method: :delete,
          data: { turbo_confirm: t('.confirm_delete') },
          class: "text-red-600 border border-red-200 px-4 py-1.5 rounded hover:bg-red-50 cursor-pointer bg-white" %>
    <% end %>
    <%= link_to t('.back'), articles_path, class: "text-gray-500 hover:text-gray-700 ml-auto" %>
  </div>
</div>
<div class="mt-6 bg-white border border-gray-200 rounded-lg p-6">
  <h2 class="text-base font-medium text-gray-800 mb-4">
    <%= t('comments.section_title', count: @article.comments.count) %>
  </h2>

  <div class="divide-y divide-gray-100">
    <%# eager load 済みのデータをそのまま使う %>
    <%= render @article.comments.recent %>
  </div>

  <% if @article.comments.empty? %>
    <p class="text-sm text-gray-400 text-center py-6"><%= t('comments.empty') %></p>
  <% end %>

  <div class="mt-6 pt-6 border-t border-gray-100">
    <%= render "comments/form" %>
  </div>
</div>
