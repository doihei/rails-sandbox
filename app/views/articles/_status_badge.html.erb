<% badge_class = case article.status.value
   when "published" then "bg-green-100 text-green-700"
   when "draft"     then "bg-gray-100 text-gray-600"
   when "archived"  then "bg-orange-100 text-orange-700"
   end %>
<span class="text-xs px-2 py-0.5 rounded-full font-medium <%= badge_class %>">
  <%= t("article_status.#{article.status.value}") %>
</span>
