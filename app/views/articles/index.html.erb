<% content_for :title, t('.title') %>

<div data-controller="articles-index">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-semibold text-gray-800"><%= t('.title') %></h1>
    <%= link_to t('.new_button'), new_article_path,
        class: "bg-gray-800 text-white text-sm px-4 py-2 rounded hover:bg-gray-700" %>
  </div>

  <%# ローディング表示 %>
  <div data-articles-index-target="loading" hidden
       class="text-sm text-gray-400 text-center py-12">
    <%= t('.loading') %>
  </div>

  <%# エラー表示 %>
  <div data-articles-index-target="error" hidden
       class="bg-red-50 border-l-4 border-red-400 text-red-700 px-4 py-3 text-sm rounded">
  </div>

  <%# 記事一覧（Stimulus が書き換える） %>
  <div id="articles"
       data-articles-index-target="list"
       class="flex flex-col gap-3">
  </div>

  <%# もっと見るボタン %>
  <div data-articles-index-target="pagination" hidden class="mt-6 text-center">
    <button data-action="click->articles-index#loadMore"
            class="bg-gray-800 text-white text-sm px-6 py-2 rounded hover:bg-gray-700">
      <%= t('.load_more') %>
    </button>
  </div>
</div>
