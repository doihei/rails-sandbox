<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-semibold text-gray-800"><%= t('.title') %></h1>
  <% if user_signed_in? %>
  <%= link_to t('.new_button'), new_article_path,
        class: "bg-gray-800 text-white text-sm px-4 py-2 rounded hover:bg-gray-700" %>
  <% end %>
</div>
<p class="text-sm text-gray-600">
  <%= t('.description') %>
</p>

<% if @articles.any? %>
  <div class="flex flex-col gap-3">
    <% @articles.each do |article| %>
      <%= render Articles::CardComponent.new(article: article) %>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12">
    <p class="text-gray-500 text-lg">
      <%= t('.no_popular_articles') %>
    </p>
    <p class="text-gray-400 text-sm mt-2">
      <%= t('.no_popular_articles_hint') %>
    </p>
  </div>
<% end %>
