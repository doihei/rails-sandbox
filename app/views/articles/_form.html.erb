<%= form_with(model: article, class: "bg-white border border-gray-200 rounded-lg p-6") do |form| %>
  <% if article.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 text-red-700 px-4 py-3 text-sm mb-4 rounded">
      <% article.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-4" data-controller="character-count">
    <%= form.label :title, t('.title_label'), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :title,
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-gray-500",
        data: { character_count_target: "input", action: "input->character-count#update" } %>
    <p class="text-xs text-gray-400 mt-1">
      <span data-character-count-target="count">0</span><%= t('.char_count_suffix') %>
    </p>
  </div>

  <div class="mb-6" data-controller="character-count">
    <%= form.label :body, t('.body_label'), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.textarea :body, rows: 8,
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-gray-500",
        data: { character_count_target: "input", action: "input->character-count#update" } %>
    <p class="text-xs text-gray-400 mt-1">
      <span data-character-count-target="count">0</span> 文字
    </p>
  </div>

  <div class="mb-6">
    <%= form.label :tag_names, t('.tag_names_label'),
        class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :tag_names,
        value: article.tags.map(&:name).join(", "),
        placeholder: t('.tag_names_placeholder'),
        class: "w-full border border-gray-300 rounded px-3 py-2 text-sm
                focus:outline-none focus:border-gray-500" %>
    <p class="text-xs text-gray-400 mt-1"><%= t('.tag_names_hint') %></p>
  </div>

  <div class="flex gap-3">
    <%= form.submit article.persisted? ? t('.submit_update') : t('.submit_create'),
        class: "bg-gray-800 text-white px-5 py-2 rounded text-sm hover:bg-gray-700 cursor-pointer" %>
    <%= link_to t('.cancel'), article.persisted? ? article : articles_path,
        class: "text-sm text-gray-500 hover:text-gray-700 px-4 py-2" %>
  </div>
<% end %>
