<% content_for :title, t('.title') %>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-semibold text-gray-800"><%= t('.title') %></h1>
  <%= link_to t('.back'), articles_path,
      class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<% if @tags.any? %>
  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
      <% @tags.each do |tag| %>
        <%= link_to tag_path(tag),
            class: "flex items-center justify-between p-3 rounded
                   border border-gray-200 hover:border-blue-300
                   hover:bg-blue-50 transition-colors" do %>
          <span class="text-sm font-medium text-gray-800"><%= tag.name %></span>
          <span class="text-xs text-gray-500">
            <%= t('.count', count: tag.articles_count) %>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="text-center py-12">
    <p class="text-gray-500 text-lg"><%= t('.empty') %></p>
  </div>
<% end %>
