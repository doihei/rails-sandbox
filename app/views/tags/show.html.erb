<% content_for :title, t('tags.show.title', name: @tag.name) %>

<div class="flex justify-between items-center mb-6">
  <div class="flex items-center gap-3">
    <h1 class="text-2xl font-semibold text-gray-800">
      <%= t('tags.show.title', name: @tag.name) %>
    </h1>
    <span class="text-sm text-gray-400">
      <%= t('tags.show.count', count: @articles.count) %>
    </span>
  </div>
  <%= link_to t('tags.show.back'), articles_path,
      class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<% if @articles.empty? %>
  <p class="text-sm text-gray-400 text-center py-12">
    <%= t('tags.show.empty') %>
  </p>
<% else %>
  <div class="flex flex-col gap-3">
    <% @articles.each do |article| %>
      <%= render(Articles::CardComponent.new(article: article)) %>
    <% end %>
  </div>
<% end %>
