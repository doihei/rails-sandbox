<% content_for :title, "アカウント設定" %>

<div class="max-w-sm mx-auto">
  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h1 class="text-xl font-semibold text-gray-800 mb-6">アカウント設定</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-gray-500" %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="text-xs text-gray-400 mt-1">確認待ち: <%= resource.unconfirmed_email %></p>
        <% end %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "新しいパスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-400 mb-1">変更しない場合は空欄のまま</p>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-gray-500" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mt-1"><%= @minimum_password_length %>文字以上</p>
        <% end %>
      </div>

      <div class="mb-4">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-gray-500" %>
      </div>

      <div class="mb-6">
        <%= f.label :current_password, "現在のパスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <p class="text-xs text-gray-400 mb-1">変更を確定するために必要です</p>
        <%= f.password_field :current_password, autocomplete: "current-password",
            class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-gray-500" %>
      </div>

      <%= f.submit "更新する",
          class: "w-full bg-gray-800 text-white py-2 rounded text-sm hover:bg-gray-700 cursor-pointer" %>
    <% end %>
  </div>

  <div class="mt-4 bg-white border border-red-100 rounded-lg p-6">
    <h2 class="text-sm font-medium text-red-700 mb-3">アカウント削除</h2>
    <%= button_to "アカウントを削除する", registration_path(resource_name),
        data: { turbo_confirm: "本当に削除しますか？" }, method: :delete,
        class: "text-red-600 border border-red-200 px-4 py-1.5 rounded text-sm hover:bg-red-50 cursor-pointer bg-white" %>
  </div>

  <%= render "devise/shared/links" %>
</div>
