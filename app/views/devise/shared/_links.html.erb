<div class="mt-4 flex flex-col gap-2 text-sm text-center">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to "ログイン", new_session_path(resource_name), class: "text-gray-500 hover:text-gray-700" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to "アカウント登録", new_registration_path(resource_name), class: "text-gray-500 hover:text-gray-700" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to "パスワードを忘れた方", new_password_path(resource_name), class: "text-gray-500 hover:text-gray-700" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "確認メールが届いていない方", new_confirmation_path(resource_name), class: "text-gray-500 hover:text-gray-700" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to "アカウントのロック解除", new_unlock_path(resource_name), class: "text-gray-500 hover:text-gray-700" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p><%= button_to "#{OmniAuth::Utils.camelize(provider)}でログイン", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "text-gray-500 hover:text-gray-700 cursor-pointer bg-transparent border-none text-sm" %></p>
    <% end %>
  <% end %>
</div>
